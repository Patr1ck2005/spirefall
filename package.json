{
  "name": "gun-mayhem-redux-clean-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx server/server.ts\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx server/server.ts",
    "build": "tsc --noEmit && vite build",
    "test:logic": "tsx tests/game-logic.ts",
    "test:smoke": "tsx tests/network-smoke.ts",
    "test:browser": "tsx tests/browser-smoke.ts",
    "test:visual": "tsx tests/visual-smoke.ts",
    "test:performance": "tsx tests/performance-smoke.ts",
    "start": "tsx server/server.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
